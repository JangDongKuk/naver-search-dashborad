# 이 파일을 프로젝트 루트에 ".env" 로 복사한 뒤 값을 채우세요.
#   Windows PowerShell:  Copy-Item config\.env.example .env

# 사용할 플랫폼
#   apihub     : NAVER Cloud Platform / API Hub  (https://api.ncloud-docs.com/docs/naver-api-hub-overview)
#                콘솔 > API Hub 에서 앱 등록 후 발급되는 Client ID / Client Secret
#   developers : 기존 개발자센터 (https://developers.naver.com)  * 검색 API 2026-07-31 종료 예정
NAVER_API_PLATFORM=apihub

NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here
